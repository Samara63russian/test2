FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DATABASE_PATH=/data/medication_bot.db

WORKDIR /app

COPY pyproject.toml README.md ./
COPY medication_bot ./medication_bot
RUN pip install --no-cache-dir .

RUN useradd --create-home --uid 10001 bot \
    && mkdir -p /data \
    && chown bot:bot /data

USER bot

CMD ["python", "-m", "medication_bot"]
