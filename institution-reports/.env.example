# Public HTTPS URL of the API for production and Android builds.
# Leave unset for local development (Vite proxies /api to localhost:3001).
VITE_API_URL=https://reports.example.ru/api

# Server settings
PORT=3001
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=server/data/reports.db
CORS_ORIGIN=https://reports.example.ru,capacitor://localhost,https://localhost,http://localhost
