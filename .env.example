# Server
PORT=3000

# IMAP mailbox (required for real email synchronization)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=sales@example.com
IMAP_PASSWORD=app-password
IMAP_FOLDER=INBOX

# Optional: local generative AI. Without it, the built-in free analyzer is used.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
