[Unit]
Description=Schweiz zahlt Admin & Analytics Backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/schweiz-zahlt/backend
EnvironmentFile=/etc/schweiz-zahlt.env
ExecStart=/var/www/schweiz-zahlt/backend/venv/bin/gunicorn -w 2 -b 127.0.0.1:5050 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
