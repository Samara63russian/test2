<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:orientation="vertical" android:padding="24dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="Сводные справки" android:textSize="26sp" android:textStyle="bold"
            android:textColor="@color/navy" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Быстрое заполнение формы. Выгрузка при появлении интернета."
            android:layout_marginTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/server" android:hint="Адрес сервера" android:layout_marginTop="20dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/username" android:hint="Логин" android:layout_marginTop="8dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/password" android:hint="Пароль" android:inputType="textPassword"
            android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/error" android:textColor="#B42318" android:layout_marginTop="8dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/login" android:text="Войти" android:layout_marginTop="16dp"
            android:backgroundTint="@color/teal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
