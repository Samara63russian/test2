<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="20dp"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="Мобильная сводка" android:textSize="24sp" android:textStyle="bold"
        android:textColor="@color/navy" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/status" android:layout_marginTop="12dp" android:textSize="16sp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/newReport" android:text="Новая справка" android:layout_marginTop="24dp"
        android:backgroundTint="@color/teal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/sync" android:text="Выгрузить на сервер" android:layout_marginTop="8dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/reports" android:text="Скачать итоговый документ" android:layout_marginTop="8dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/logout" android:text="Выйти" android:layout_marginTop="8dp"
        android:backgroundTint="#667085" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
